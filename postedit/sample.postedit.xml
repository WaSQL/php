<!-- postedit.xml - configuration file for postedit.php
	settings
		editor attributes:
			command - command to run. For instance: open up sublime and load file on left
				Sublime Command:
					C:/Program Files/Sublime Text 3/subl.exe --add
				Notepad++ Command
					php d:/wasql/php/postedit_notepad.php
	Hosts - container for mulitple host entries
		Host attributes:
			name - host name
			alias - alias name to call the directory files go into
			username - username on this
			apikey - apikey of username
			tables - defaults to getting _models, _pages, _tables
			spokenname - optional; how the project is spoken in sound mode="speak" (defaults to the alias, e.g. spokenname="dex p d q")
			groupby - name,field, type, or extension.  Groups files by file name, field(body,controller,functions,js,css), type(models, views, controllers), or extension (html,php,js,css)
-->
<settings>
	<!-- sound tag will say things
		mode - how saves are announced:
			speak - (default) result sound; when several files saved at once it then speaks a summary led by the
					project (host spokenname, else alias): "dexpdq 10 saved", "dexpdq 9 saved, index body failed".
					A single file plays just the chime (success or failure) - no speech - in every mode.
					Also says "postedit dexpdq ready" at startup and "postedit dexpdq stopped. {reason}" when it dies.
			beep  - no speech; several files get one short beep each (high=saved, low=failed), then the result sound
			wav   - no speech; the result sound once per file, back to back
	-->
	<sound
		mode="speak"
		success="Ok"
		fail="Error!"
		gender="m"
	/>
	<!-- editor tag will run the command on success.-->
	<editor
		command="subl --add"
	/>
</settings>
<hosts>
	<host
		name="localhost"
		alias="localhost"
		apikey="YOURAPIKEY"
		username="admin"
		groupby="name"
		insecure="1"
		datestamp="1"
		days_to_keep="30"
	/>
</hosts>

