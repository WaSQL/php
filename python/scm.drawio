  <diagram name="Big Picture" id="page1">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p1_title" value="SCM = version control for your database schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="60" width="930" height="70" as="geometry" />
        </mxCell>
        <mxCell id="p1_sub" value="Each schema change is a plain SQL file, tracked and applied in order." style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontColor=#555555;" vertex="1" parent="1">
          <mxGeometry x="120" y="140" width="930" height="30" as="geometry" />
        </mxCell>
        <mxCell id="p1_files" value="📁&#xa;SQL migration files&#xa;(in git)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="120" y="270" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p1_engine" value="⚙️&#xa;scm" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DEEBF7;strokeColor=#2E75B6;fontSize=22;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="455" y="270" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p1_db" value="🗄️&#xa;Your database" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="270" width="260" height="180" as="geometry" />
        </mxCell>
        <mxCell id="p1_e1" value="applies" style="html=1;strokeColor=#2E75B6;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontColor=#2E75B6;" edge="1" parent="1" source="p1_files" target="p1_engine">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_e2" value="changes + tracks" style="html=1;strokeColor=#2E75B6;strokeWidth=3;endArrow=block;endFill=1;fontSize=14;fontColor=#2E75B6;" edge="1" parent="1" source="p1_engine" target="p1_db">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p1_foot" value="Run it anywhere — SCM applies only what&#39;s missing, so every environment ends up identical." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="120" y="530" width="930" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="The Loop" id="page2">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p2_title" value="The everyday loop" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=none;fontColor=#FFFFFF;fontSize=28;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="120" y="50" width="930" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p2_new" value="scm new&#xa;&#xa;create a migration file" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="140" y="200" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2_edit" value="edit the file&#xa;&#xa;write your SQL&#xa;(up + down)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="460" y="200" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2_up" value="scm up&#xa;&#xa;apply it to the database" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=18;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="780" y="200" width="250" height="120" as="geometry" />
        </mxCell>
        <mxCell id="p2_a1" style="html=1;strokeColor=#666666;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="p2_new" target="p2_edit">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_a2" style="html=1;strokeColor=#666666;strokeWidth=3;endArrow=block;endFill=1;" edge="1" parent="1" source="p2_edit" target="p2_up">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p2_back" value="repeat" style="html=1;strokeColor=#999999;strokeWidth=3;dashed=1;endArrow=block;endFill=1;fontSize=14;fontColor=#666666;exitX=0.5;exitY=1;entryX=0.5;entryY=1;" edge="1" parent="1" source="p2_up" target="p2_new">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="905" y="390" />
              <mxPoint x="265" y="390" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="p2_undo" value="↩  Made a mistake?    scm down  rolls the last change back    •    scm status  shows applied vs pending" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FBE4E4;strokeColor=#C00000;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="140" y="460" width="890" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p2_setup" value="First time on a database?   scm env-from-config &lt;name&gt;  (WaSQL)  or  scm init  — sets it up once." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DEEBF7;strokeColor=#2E75B6;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="140" y="545" width="890" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="With vs Without AI" id="page3">
    <mxGraphModel dx="1884" dy="995" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p3_title" value="Two ways to use it — same files, same commands" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=none;fontColor=#FFFFFF;fontSize=26;fontStyle=1;verticalAlign=middle;align=center;" parent="1" vertex="1">
          <mxGeometry x="80" y="40" width="1000" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p3_manh" value="✋  By hand" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#5B9BD5;strokeColor=none;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="80" y="130" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3_m1" value="You decide the change" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DEEBF7;strokeColor=#2E75B6;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="130" y="200" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_m2" value="scm new  →  you write the SQL&#xa;(up + down)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DEEBF7;strokeColor=#2E75B6;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="130" y="285" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_m3" value="You review it" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DEEBF7;strokeColor=#2E75B6;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="130" y="370" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_m4" value="scm up  →  you apply it" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="130" y="455" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_ma1" style="html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" parent="1" source="p3_m1" target="p3_m2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_ma2" style="html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" parent="1" source="p3_m2" target="p3_m3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_ma3" style="html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" parent="1" source="p3_m3" target="p3_m4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_mnote" value="Good when you know the SQL well,&#xa;or the change is too sensitive to delegate." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="130" y="520" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3_aih" value="🤖  With Claude / AI" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#9673A6;strokeColor=none;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;" parent="1" vertex="1">
          <mxGeometry x="600" y="130" width="480" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3_a1" value="You describe the change" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="650" y="200" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_a2" value="Claude runs scm new &amp; writes the SQL&#xa;(never touches the DB directly)" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;" parent="1" vertex="1">
          <mxGeometry x="650" y="285" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_a3" value="You review it" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=15;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="650" y="370" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_a4" value="scm up  →  you apply it" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="650" y="455" width="380" height="55" as="geometry" />
        </mxCell>
        <mxCell id="p3_aa1" style="html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" parent="1" source="p3_a1" target="p3_a2" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_aa2" style="html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" parent="1" source="p3_a2" target="p3_a3" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_aa3" style="html=1;strokeColor=#666666;strokeWidth=2;endArrow=block;" parent="1" source="p3_a3" target="p3_a4" edge="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p3_anote" value="The rule: AI never runs DDL directly — it always&#xa;produces a migration file, so its work is tracked &amp; reversible." style="text;html=1;align=center;verticalAlign=middle;fontSize=13;fontColor=#555555;" parent="1" vertex="1">
          <mxGeometry x="650" y="520" width="380" height="40" as="geometry" />
        </mxCell>
        <mxCell id="p3_foot" value="Either way you end up with the same reviewed SQL file in git — and you always run scm up yourself." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=15;fontStyle=1;" parent="1" vertex="1">
          <mxGeometry x="80" y="590" width="1000" height="55" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram name="Same Schema Everywhere" id="page4">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1169" pageHeight="826" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="p4_title" value="How every environment ends up with the same schema" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#2E75B6;strokeColor=none;fontColor=#FFFFFF;fontSize=24;fontStyle=1;verticalAlign=middle;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="30" width="1050" height="54" as="geometry" />
        </mxCell>
        <!-- ONE SOURCE OF TRUTH -->
        <mxCell id="p4_files" value="📁  One set of migration files (in git)&#xa;&#xa;20240601_create_users&#xa;20240602_add_email_index&#xa;20240603_add_orders" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=14;fontStyle=1;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="380" y="105" width="410" height="120" as="geometry" />
        </mxCell>
        <!-- DEV -->
        <mxCell id="p4_dev" value="DEV" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=top;fillColor=#DEEBF7;strokeColor=#2E75B6;fontSize=16;fontStyle=1;verticalAlign=middle;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="80" y="300" width="300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p4_devt" value="schema_migrations&#xa;──────────────────&#xa;20240601   ✓&#xa;20240602   ✓&#xa;20240603   ✓" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#2E75B6;fontSize=13;fontFamily=Courier New;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="80" y="334" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_devs" value="Up to date — scm up does nothing" style="text;html=1;align=center;fontSize=12;fontColor=#82B366;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="490" width="300" height="24" as="geometry" />
        </mxCell>
        <!-- STAGE -->
        <mxCell id="p4_stg" value="STAGE" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DEEBF7;strokeColor=#2E75B6;fontSize=16;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="435" y="300" width="300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p4_stgt" value="schema_migrations&#xa;──────────────────&#xa;20240601   ✓&#xa;20240602   ✓&#xa;20240603   ← pending" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#2E75B6;fontSize=13;fontFamily=Courier New;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="435" y="334" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_stgs" value="scm up applies only 20240603" style="text;html=1;align=center;fontSize=12;fontColor=#D6B656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="435" y="490" width="300" height="24" as="geometry" />
        </mxCell>
        <!-- PROD -->
        <mxCell id="p4_prod" value="PROD" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#DEEBF7;strokeColor=#2E75B6;fontSize=16;fontStyle=1;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="790" y="300" width="300" height="34" as="geometry" />
        </mxCell>
        <mxCell id="p4_prodt" value="schema_migrations&#xa;──────────────────&#xa;20240601   ✓&#xa;20240602   ← pending&#xa;20240603   ← pending" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;fillColor=#FFFFFF;strokeColor=#2E75B6;fontSize=13;fontFamily=Courier New;spacingLeft=12;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="790" y="334" width="300" height="150" as="geometry" />
        </mxCell>
        <mxCell id="p4_prods" value="scm up applies 20240602 + 20240603" style="text;html=1;align=center;fontSize=12;fontColor=#D6B656;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="790" y="490" width="300" height="24" as="geometry" />
        </mxCell>
        <!-- arrows from files to each env -->
        <mxCell id="p4_fa1" style="html=1;strokeColor=#D6B656;strokeWidth=2;endArrow=block;endFill=1;exitX=0.25;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4_files" target="p4_dev">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_fa2" style="html=1;strokeColor=#D6B656;strokeWidth=2;endArrow=block;endFill=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4_files" target="p4_stg">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_fa3" style="html=1;strokeColor=#D6B656;strokeWidth=2;endArrow=block;endFill=1;exitX=0.75;exitY=1;entryX=0.5;entryY=0;" edge="1" parent="1" source="p4_files" target="p4_prod">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="p4_rule" value="Each database keeps its OWN schema_migrations table — a checklist of the versions it has already run.&#xa;scm up compares the files against that table and applies only the missing ones, oldest first, in a transaction." style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#E1D5E7;strokeColor=#9673A6;fontSize=14;" vertex="1" parent="1">
          <mxGeometry x="80" y="540" width="1010" height="60" as="geometry" />
        </mxCell>
        <mxCell id="p4_foot" value="✅  Same files + per-environment checklist  →  run scm up anywhere and it converges to the exact same schema. No drift, no &quot;did we run that one?&quot;" style="rounded=1;whiteSpace=wrap;html=1;align=center;verticalAlign=middle;fillColor=#D5E8D4;strokeColor=#82B366;fontSize=15;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="80" y="620" width="1010" height="60" as="geometry" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
